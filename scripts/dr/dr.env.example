# Copy to /etc/contactcentre/dr.env (mode 0600, owned by `dr`).
# Every variable below is required.

# Postgres connection. Backups run AS the postgres superuser, hence
# the local connection. Set HOST=127.0.0.1 if running off-host.
PGHOST=/var/run/postgresql
PGUSER=postgres
PGDATABASE=contactcentre

# Where pg_basebackup writes its staging dir before encrypt+upload.
STAGING_DIR=/var/backups/contactcentre

# Off-site object store. We use mc (MinIO client) because it speaks
# both S3 and MinIO with the same syntax.
OFFSITE_BUCKET=s3://cc-dr-nairobi/contactcentre
MC_ALIAS=offsite
MC_ALIAS_URL=https://offsite.dr.example.co.ke
MC_ACCESS_KEY=replaceme
MC_SECRET_KEY=replaceme

# Primary MinIO -- the bucket the document service writes to.
PRIMARY_MC_ALIAS=primary
PRIMARY_MC_ALIAS_URL=https://minio.internal.example.co.ke
PRIMARY_MC_ACCESS_KEY=replaceme
PRIMARY_MC_SECRET_KEY=replaceme
PRIMARY_BUCKET=docs

# Client-side encryption. The recipient public key is `age1...`.
# The private key MUST NOT live on backup hosts -- the DPO holds it.
AGE_RECIPIENT=age1...replaceme...

# Retention.
PG_BASE_KEEP_DAYS=35
WAL_KEEP_DAYS=14
MINIO_MIRROR_KEEP_DAYS=90
