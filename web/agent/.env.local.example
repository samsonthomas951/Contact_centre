# Copy to .env.local and fill in.

# Gateway (the Go API).
NEXT_PUBLIC_GATEWAY_URL=https://app.example.co.ke
NEXT_PUBLIC_WS_URL=wss://ws.example.co.ke

# NextAuth / Zitadel.
AUTH_SECRET=replace-with-`openssl rand -base64 32`
AUTH_TRUST_HOST=true
ZITADEL_ISSUER=https://auth.example.co.ke
ZITADEL_CLIENT_ID=contact-centre-agent
ZITADEL_CLIENT_SECRET=replaceme
