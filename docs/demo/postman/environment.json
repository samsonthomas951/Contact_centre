{
  "id": "cc-demo-env",
  "name": "Contact Centre — Demo",
  "values": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "default",
      "enabled": true,
      "description": "Gateway base URL. Swap to your cloudflared URL for the live Meta-webhook tests."
    },
    {
      "key": "tenant_id",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "default",
      "enabled": true,
      "description": "Demo tenant Acme — seeded by `make demo-seed`."
    },
    {
      "key": "ada_bearer",
      "value": "demo:22222222-2222-2222-2222-222222222222:11111111-1111-1111-1111-111111111111:agent",
      "type": "secret",
      "enabled": true,
      "description": "Agent role. Can use ticket + document + connector endpoints."
    },
    {
      "key": "bob_bearer",
      "value": "demo:33333333-3333-3333-3333-333333333333:11111111-1111-1111-1111-111111111111:supervisor",
      "type": "secret",
      "enabled": true,
      "description": "Supervisor role. Adds /supervisor + /analytics access."
    },
    {
      "key": "carol_bearer",
      "value": "demo:44444444-4444-4444-4444-444444444444:11111111-1111-1111-1111-111111111111:admin",
      "type": "secret",
      "enabled": true,
      "description": "Admin role. Adds /onboarding access; can also resolve DSRs."
    },
    {
      "key": "diana_bearer",
      "value": "demo:55555555-5555-5555-5555-555555555555:11111111-1111-1111-1111-111111111111:dpo",
      "type": "secret",
      "enabled": true,
      "description": "DPO role. Full /dsr access (open / assign / resolve / action)."
    },
    {
      "key": "conversation_id",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Filled by Tickets > List (script grabs the first row's conversation_id)."
    },
    {
      "key": "ticket_id",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Filled by Tickets > List."
    },
    {
      "key": "dsr_id",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Filled by DSR > Open."
    },
    {
      "key": "csat_token",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Paste a token from a sent CSAT survey to test the public submit."
    },
    {
      "key": "widget_id",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Filled by 8. Onboarding > Register widget."
    },
    {
      "key": "widget_embed_key",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Embed key returned by Register widget (paste into the <script data-embed-key=\"...\"> snippet)."
    },
    {
      "key": "email_signing_key",
      "value": "demo-email-webhook-key",
      "type": "secret",
      "enabled": true,
      "description": "HMAC signing key the demo mailbox is seeded with. Pre-request script in '8c. Email > Inbound webhook' signs the body with this."
    }
  ],
  "_postman_variable_scope": "environment"
}
