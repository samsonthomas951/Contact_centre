    {
      "name": "2. Tickets (Ada — agent)",
      "item": [
        {
          "name": "List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const rows = json.tickets || json.rows || [];",
                  "if (rows.length) {",
                  "  pm.environment.set('ticket_id', rows[0].id);",
                  "  pm.environment.set('conversation_id', rows[0].conversation_id);",
                  "  console.log('Saved ticket_id =', rows[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ada_bearer}}" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/tickets?state=open&limit=20",
              "host": ["{{base_url}}"],
              "path": ["v1", "tickets"],
              "query": [
                { "key": "state", "value": "open" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "List tickets visible to Ada. The test script saves the first row's ticket_id + conversation_id so the next requests can use them."
          }
        },
        {
          "name": "Get one",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ada_bearer}}" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/tickets/{{ticket_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "tickets", "{{ticket_id}}"]
            }
          }
        },
        {
          "name": "List messages",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ada_bearer}}" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/tickets/{{ticket_id}}/messages?limit=50",
              "host": ["{{base_url}}"],
              "path": ["v1", "tickets", "{{ticket_id}}", "messages"],
              "query": [{ "key": "limit", "value": "50" }]
            }
          }
        },
        {
          "name": "Append message (agent reply)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ada_bearer}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direction\": \"out\",\n  \"body\": \"Hi! I'm looking into this for you now.\",\n  \"attachments\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/tickets/{{ticket_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["v1", "tickets", "{{ticket_id}}", "messages"]
            },
            "description": "Sends an outbound message. The fan-out publishes on `outbound.<channel>.text`; the demo stub writes it to `outbound_log`."
          }
        },
        {
          "name": "Patch state (open → pending)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ada_bearer}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"state\": \"pending\" }"
            },
            "url": {
              "raw": "{{base_url}}/v1/tickets/{{ticket_id}}/state",
              "host": ["{{base_url}}"],
              "path": ["v1", "tickets", "{{ticket_id}}", "state"]
            },
            "description": "State transitions are validated by `internal/ticket/state.go`. Try `solved` next, then `closed`."
          }
        },
        {
          "name": "Create new ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ada_bearer}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"priority\": 3,\n  \"required_skills\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/tickets",
              "host": ["{{base_url}}"],
              "path": ["v1", "tickets"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Documents (Ada — agent)",
      "item": [
        {
          "name": "Upload (multipart)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ada_bearer}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Pick any file < 25 MiB. Allowed types: pdf, png, jpeg, txt, csv, docx."
                },
                {
                  "key": "ticket_id",
                  "type": "text",
                  "value": "{{ticket_id}}",
                  "description": "Optional. Links the doc to a ticket."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/documents",
              "host": ["{{base_url}}"],
              "path": ["v1", "documents"]
            },
            "description": "Upload streams to MinIO with SSE-S3, scans via ClamAV before commit. Response includes the doc id you'll use to download."
          }
        },
        {
          "name": "Download (presigned)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ada_bearer}}" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/documents/{{document_id}}/download",
              "host": ["{{base_url}}"],
              "path": ["v1", "documents", "{{document_id}}", "download"]
            },
            "description": "Returns a 5-min presigned URL. Set `document_id` manually after running Upload."
          }
        }
      ]
    },
