    {
      "name": "7. DSR (Diana — dpo)",
      "item": [
        {
          "name": "List requests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{diana_bearer}}" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/dsr",
              "host": ["{{base_url}}"],
              "path": ["v1", "dsr"]
            }
          }
        },
        {
          "name": "Open access request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const r = pm.response.json();",
                  "  pm.environment.set('dsr_id', r.id);",
                  "  console.log('Saved dsr_id =', r.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{diana_bearer}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject_email\": \"customer@example.com\",\n  \"kind\": \"access\",\n  \"reason\": \"Subject requested copy of all data we hold under Kenya DPA s.26.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/dsr",
              "host": ["{{base_url}}"],
              "path": ["v1", "dsr"]
            },
            "description": "Kinds: `access`, `correction`, `erasure`, `objection`, `portability`, `restriction`."
          }
        },
        {
          "name": "Get one",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{diana_bearer}}" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/dsr/{{dsr_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "dsr", "{{dsr_id}}"]
            }
          }
        },
        {
          "name": "Assign to Diana",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{diana_bearer}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"agent_id\": \"55555555-5555-5555-5555-555555555555\" }"
            },
            "url": {
              "raw": "{{base_url}}/v1/dsr/{{dsr_id}}/assign",
              "host": ["{{base_url}}"],
              "path": ["v1", "dsr", "{{dsr_id}}", "assign"]
            }
          }
        },
        {
          "name": "Record action (note)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{diana_bearer}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"note\",\n  \"detail\": \"Verified subject identity via passport scan; preparing data export.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/dsr/{{dsr_id}}/actions",
              "host": ["{{base_url}}"],
              "path": ["v1", "dsr", "{{dsr_id}}", "actions"]
            }
          }
        },
        {
          "name": "Resolve (fulfil)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{diana_bearer}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"fulfilled\",\n  \"summary\": \"Provided data export to subject via secure download link.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/dsr/{{dsr_id}}/resolve",
              "host": ["{{base_url}}"],
              "path": ["v1", "dsr", "{{dsr_id}}", "resolve"]
            }
          }
        }
      ]
    },
    {
      "name": "8. Onboarding (Carol — admin)",
      "item": [
        {
          "name": "Get my tenant",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{carol_bearer}}" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/onboarding/tenant",
              "host": ["{{base_url}}"],
              "path": ["v1", "onboarding", "tenant"]
            }
          }
        },
        {
          "name": "Update retention policy",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{carol_bearer}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages_days\": 365,\n  \"documents_days\": 1825,\n  \"audit_days\": 2555\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/onboarding/tenant/retention",
              "host": ["{{base_url}}"],
              "path": ["v1", "onboarding", "tenant", "retention"]
            },
            "description": "Each value clamped to [7, 3650] days."
          }
        },
        {
          "name": "Invite agent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{carol_bearer}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.agent@demo.local\",\n  \"display_name\": \"New Agent\",\n  \"role\": \"agent\",\n  \"max_concurrent\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/onboarding/agents",
              "host": ["{{base_url}}"],
              "path": ["v1", "onboarding", "agents"]
            }
          }
        },
        {
          "name": "List widgets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{carol_bearer}}" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/onboarding/widgets",
              "host": ["{{base_url}}"],
              "path": ["v1", "onboarding", "widgets"]
            },
            "description": "Returns every widget origin registered to this tenant. The seed inserts one row (http://localhost:8000)."
          }
        },
        {
          "name": "Register widget",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const r = pm.response.json();",
                  "  pm.environment.set('widget_id', r.id);",
                  "  pm.environment.set('widget_embed_key', r.embed_key);",
                  "  console.log('Saved widget_id + embed_key');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{carol_bearer}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"https://shop.example.co.ke\",\n  \"display_name\": \"Example Shop — main site\",\n  \"welcome_message\": \"Karibu! How can we help?\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/onboarding/widgets",
              "host": ["{{base_url}}"],
              "path": ["v1", "onboarding", "widgets"]
            },
            "description": "Origin must be scheme://host with no path/query. Duplicate origin returns 409. Response includes a fresh embed_key for the <script> snippet."
          }
        },
        {
          "name": "Patch widget (toggle active, edit welcome)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{carol_bearer}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"welcome_message\": \"Updated greeting!\", \"active\": true }"
            },
            "url": {
              "raw": "{{base_url}}/v1/onboarding/widgets/{{widget_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "onboarding", "widgets", "{{widget_id}}"]
            }
          }
        },
        {
          "name": "Delete widget",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{carol_bearer}}" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/onboarding/widgets/{{widget_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "onboarding", "widgets", "{{widget_id}}"]
            },
            "description": "Hard-delete so the brand can re-register the same origin afterwards."
          }
        }
      ]
    },
    {
      "name": "8b. Meta callbacks (public — HMAC-signed)",
      "item": [
        {
          "name": "Status page (no-data baseline)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/meta/deletion-status/00000000-0000-0000-0000-000000000000",
              "host": ["{{base_url}}"],
              "path": ["v1", "meta", "deletion-status", "00000000-0000-0000-0000-000000000000"]
            },
            "description": "Public status page. Returns HTML. Used to verify the public reachability before submitting your data-deletion URL to Meta for App Review."
          }
        },
        {
          "name": "Data deletion — invalid signature (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "signed_request", "value": "AAAA.AAAA" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/meta/data-deletion",
              "host": ["{{base_url}}"],
              "path": ["v1", "meta", "data-deletion"]
            },
            "description": "Negative test: signed_request with a bogus HMAC must be rejected with 401. Confirms the signature check is wired before any DSR is opened."
          }
        }
      ]
    },
